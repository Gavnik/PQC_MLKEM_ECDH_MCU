/* USB-CDC console: make the Pico's own USB port a serial device (/dev/ttyACMx).
 * RP2350 USB device controller node is &usbd (confirmed in rp2350.dtsi). */
&usbd {
    status = "okay";
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
        zephyr,shell-uart = &cdc_acm_uart0;
    };
};
